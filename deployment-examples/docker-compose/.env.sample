DATABASE_URL=postgresql://catalogi:pg_password@postgres:5432/db
# note that in DATABASE_URL the host is 'postgres', matching the container name in docker-compose.yml
# API_PORT must match the api upstream in nginx/default.conf
API_PORT=3084
IMPORT_DATA_SOURCE_ORIGIN=wikidata

# Public URL of the instance, as seen by the browser (the nginx container listens on port 8090).
# Register ${APP_URL}/api/auth/callback and ${APP_URL}/api/auth/logout/callback in your OIDC provider.
APP_URL=http://localhost:8090

# Change these to your own OIDC provider. All four variables are required by the API at startup.
OIDC_ISSUER_URI=https://auth.example.com/realms/catalogi
OIDC_CLIENT_ID=catalogi
OIDC_CLIENT_SECRET=change-this
OIDC_MANAGE_PROFILE_URL=https://auth.example.com/realms/catalogi/account

# Change this to the OIDC email of the first Catalogi administrator. It can be
# removed after that user has signed in successfully.
CATALOGI_INITIAL_ADMIN_EMAIL=admin@example.com

# Environment identifier for environment-specific configuration
# Valid values: "local", "dev", "staging", "pre-production", "production"
# Can be used for environment-specific features like Sentry monitoring, logging levels, etc.
# Defaults to "local" if not provided
ENVIRONMENT=production

VITE_HEAD="
  <title>Catalogi - Deployment example</title>

  <script defer>
    console.log('This is a custom code in head, used in deployment example');
  </script>
"

# The following variables are used to configure the docker-compose.yml

# make sure it is aligned with DATABASE_URL:

POSTGRES_DB=db
POSTGRES_USER=catalogi
POSTGRES_PASSWORD=pg_password
